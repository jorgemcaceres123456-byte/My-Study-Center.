# ── My Study Center · variables de entorno ─────────────────────────────────
# Copia este archivo a `.env.local` para desarrollo local (ese archivo NO se sube a Git).

# Clave para que el preview local funcione al abrir. En local se inyecta en el
# bundle del navegador; NUNCA la pongas en un archivo versionado.
VITE_AI_API_KEY=sk-or-v1-TU_CLAVE_AQUI
VITE_AI_MODEL=nvidia/nemotron-3.5-super-vl:free

# ── En Vercel (Project → Settings → Environment Variables) ─────────────────
# 1 = activa el proxy serverless. Con esto el bundle del cliente NO incluye
# ninguna clave y api/ai.mjs la toma del servidor.
VITE_AI_PROXY=1
# Clave REAL, solo servidor. Sin prefijo VITE_ (así no se expone al navegador).
AI_API_KEY=sk-or-v1-TU_CLAVE_AQUI
